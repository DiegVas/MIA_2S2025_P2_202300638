digraph MBR_Report {
    rankdir=TB;
    node [shape=box, style=filled];
    graph [fontname="Arial", fontsize=12];
    node [fontname="Arial", fontsize=10];
    edge [fontname="Arial"];

    title [label="MBR Report\nDisco1.mia", fillcolor=lightblue, fontsize=14];

    mbr_info [label="MBR Information\nDisk Size: 50.00 MB\nCreation Date: October 6, 2025\nTotal Partitions: 4", fillcolor=lightyellow];

    primary_section [label="PRIMARY PARTITIONS", shape=box, style=filled, fillcolor=lightcyan];
    primary_0 [label="Part11\nType: Primary\nStatus: Active\nStart: 10485760\nSize: 10.00 MB\nFit: Best Fit", fillcolor=lightgreen];
    primary_section -> primary_0;
    primary_1 [label="Part12\nType: Primary\nStatus: Active\nStart: 20971520\nSize: 10.00 MB\nFit: Best Fit", fillcolor=lightgreen];
    primary_section -> primary_1;
    primary_2 [label="Part13\nType: Primary\nStatus: Active\nStart: 31457280\nSize: 10.00 MB\nFit: Best Fit", fillcolor=lightgreen];
    primary_section -> primary_2;
    primary_3 [label="Part14\nType: Primary\nStatus: Active\nStart: 41943040\nSize: 10.00 MB\nFit: Best Fit", fillcolor=lightgreen];
    primary_section -> primary_3;

    title -> mbr_info;
    mbr_info -> primary_section;
}
